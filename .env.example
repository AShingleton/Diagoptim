# ─── APP ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NODE_ENV=development

# ─── SUPABASE ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── DATABASE ───
DATABASE_URL=postgresql://postgres:password@localhost:5432/diagoptim

# ─── ANTHROPIC (IA) ───
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# ─── STRIPE ───
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — Subscriptions
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_EXPERT_MONTHLY=price_...
STRIPE_PRICE_EXPERT_YEARLY=price_...
STRIPE_PRICE_CONSULTANT_SOLO_MONTHLY=price_...
STRIPE_PRICE_CONSULTANT_SOLO_YEARLY=price_...
STRIPE_PRICE_CONSULTANT_CABINET_MONTHLY=price_...
STRIPE_PRICE_CONSULTANT_CABINET_YEARLY=price_...

# Stripe Price IDs — Support Packs (one-shot)
STRIPE_PRICE_PACK_COUP_DE_POUCE=price_...
STRIPE_PRICE_PACK_ACCELERATION=price_...
STRIPE_PRICE_PACK_TRANSFORMATION=price_...

# Stripe Price IDs — Support Subscriptions
STRIPE_PRICE_SUPPORT_ESSENTIEL_MONTHLY=price_...
STRIPE_PRICE_SUPPORT_PREMIUM_MONTHLY=price_...

# ─── BREVO (Emails) ───
BREVO_API_KEY=xkeysib-...
EMAIL_FROM_NAME=DiagOptim
EMAIL_FROM_EMAIL=noreply@diagoptim.com
EMAIL_REPLY_TO=support@diagoptim.com

# ─── API EXTERNES ───
SIRENE_API_KEY=...
INSEE_SIRENE_API_TOKEN=...

# ─── RAG EMBEDDINGS (choose one) ───
VOYAGE_API_KEY=pa-...           # Voyage AI (recommended, 1024 dim)
# OPENAI_API_KEY=sk-...         # OpenAI alternative (1536 dim)
# Falls back to Supabase pg_embedding (384 dim) if neither is set

# ─── VIDÉO / AUDIO ───
ELEVENLABS_API_KEY=...
MUX_TOKEN_ID=...
MUX_TOKEN_SECRET=...

# ─── ANALYTICS ───
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── ENCRYPTION ───
ENCRYPTION_KEY=  # 32 bytes hex (64 characters) for AES-256-GCM
ENCRYPTION_IV=   # 16 bytes hex (32 characters)

# ─── PUSH NOTIFICATIONS ───
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@diagoptim.com

# ─── CRON ───
CRON_SECRET=  # Secret for authenticating cron job requests
